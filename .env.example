# DeepL (可选, 500k/月免费) https://www.deepl.com/pro-api
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com

# opencode (复用 Go 订阅, OpenAI 兼容)
# 本地: http://localhost:4096/v1  云端: https://api.opencode.dev/v1
OPENCODE_BASE_URL=http://localhost:4096/v1
OPENCODE_API_KEY=
OPENCODE_MODEL=opencode/gemini-2.5-flash
# 可选: opencode/claude-sonnet-4-20250514 , opencode/gpt-4.1

# PaddleOCR sidecar (精度最高 OCR, 需 pip install paddleocr paddlepaddle)
# 自定义 Python 路径时设置, 默认用系统 PATH 中的 python
PADDLE_PYTHON=
